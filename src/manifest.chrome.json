{
  "manifest_version": 3,
  "name": "Crossposter",
  "version": "0.1.6",
  "description": "A free, open-source browser extension to share social media post — text, images, and even video — from one platform to another.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite",
    "notifications",
    "sidePanel",
    "webRequest"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://bsky.app/*",
    "https://upscrolled.com/*",
    "https://www.upscrolled.com/*",
    "https://*.video.upscrolled.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://*.twimg.com/*",
    "https://*.licdn.com/*",
    "https://www.linkedin.com/*",
    "https://video.bsky.app/*",
    "https://public.api.bsky.app/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.threads.com/*",
    "https://threads.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://facebook.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Crossposter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "tray.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/posted.svg"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://bsky.app/*",
        "https://upscrolled.com/*",
        "https://www.upscrolled.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.threads.com/*",
        "https://threads.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://facebook.com/*"
      ]
    }
  ]
}
